# Copy to .env for local runs (CI uses GitHub secrets instead).
# Every single one of these has a free tier — total cost ₦0 (PLAN.md §3).

# --- Stock visuals (free keys) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube upload (free) ---
# Copy these two values separately from the Web OAuth client in Google Cloud:
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Mint once via OAuth Playground or: python scripts/youtube_oauth.py
YOUTUBE_REFRESH_TOKEN=
# Optional playlist to auto-add uploads to:
YOUTUBE_PLAYLIST_ID=
# Only set to true AFTER your GCP project passes the YouTube API compliance
# audit (PLAN.md §3.4). Until then uploads are private + human-published:
AUTO_PUBLISH=false

# --- Channel selection (pipeline/channels.py) ---
# Which channel a run targets. secret-place (default) uses the unprefixed
# YOUTUBE_*/GEMINI_* secrets above. prayer2 (The Morning Altar) uses its own
# GCP + Gemini projects via PRAYER2_* secrets in GitHub Actions; locally, put
# that channel's values in the canonical names below and set CHANNEL_ID.
CHANNEL_ID=secret-place
# Optional UC… ID guard: abort before upload if the refresh token authorizes
# a different channel (set per channel in Actions variables for prayer2):
YOUTUBE_EXPECTED_CHANNEL_ID=

# --- Behaviour ---
DRY_RUN=1
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
TTS_VOICE=en-US-ChristopherNeural
BURN_CAPTIONS=true
MUSIC_ENABLED=false
# Auto-cut vertical Shorts from each long-form render:
MAKE_SHORTS=1
SHORTS_COUNT=2
