# Copy to .env for local runs (CI uses GitHub secrets instead).
# Every single one of these has a free tier — total cost ₦0 (PLAN.md §3).

# --- Stock visuals (free keys) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- YouTube upload (free) ---
# OAuth client secret JSON as a single line, minted in Google Cloud Console:
YOUTUBE_CLIENT_SECRET=
# Mint once with:  python scripts/youtube_oauth.py
YOUTUBE_REFRESH_TOKEN=
# Optional playlist to auto-add uploads to:
YOUTUBE_PLAYLIST_ID=
# Only set to true AFTER your GCP project passes the YouTube API compliance
# audit (PLAN.md §3.4). Until then uploads are private + human-published:
AUTO_PUBLISH=false

# --- Behaviour ---
DRY_RUN=1
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
TTS_VOICE=en-US-ChristopherNeural
BURN_CAPTIONS=true
MUSIC_ENABLED=false
# Auto-cut vertical Shorts from each long-form render:
MAKE_SHORTS=1
SHORTS_COUNT=2
